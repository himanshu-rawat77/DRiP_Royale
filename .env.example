# Copy to .env.local and fill in your keys.
# Never commit .env.local or real keys.

# --- Helius ---
NEXT_PUBLIC_HELIUS_API_KEY=
HELIUS_API_KEY=

# --- Solana ---
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_DRIP_CREATOR_ADDRESS=

# --- Wallet session auth ---
# Used to sign wallet auth challenges and session cookies.
SESSION_SECRET=replace-with-a-long-random-secret

# --- GameShift ---
# Legacy integration (still used by settlement routes until full removal).
GAMESHIFT_API_KEY=
NEXT_PUBLIC_GAMESHIFT_API_KEY=
GAMESHIFT_WALLET_KEY=
GAMESHIFT_ENV=development
